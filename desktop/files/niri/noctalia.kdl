layout {

    focus-ring {
        active-color   "#bfc2ff"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#bfc2ff"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#bfc2ff"
        inactive-color "#31357f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#bfc2ff80"
    }
}

recent-windows {
    highlight {
        active-color "#bfc2ff"
        urgent-color "#ffb4ab"
    }
}
