layout {

    focus-ring {
        active-color   "#a1c9ff"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a1c9ff"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a1c9ff"
        inactive-color "#306caa"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a1c9ff80"
    }
}

recent-windows {
    highlight {
        active-color "#a1c9ff"
        urgent-color "#ffb4ab"
    }
}
